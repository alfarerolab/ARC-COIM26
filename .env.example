# ─── OPCIÓN A: Neon (Postgres) en Vercel — lo que tenías originalmente ───────
# DATABASE_URL=postgres://usuario:clave@host/db?sslmode=require

# ─── OPCIÓN B: Backend PHP en cPanel ─────────────────────────────────────────
# Si usas el backend PHP en cPanel, deja DATABASE_URL vacío y configura esto:
# VITE_API_URL=https://tudominio.com/arc-api
# (El valor se inyecta en el build de Vercel desde Settings > Environment Variables)

# Clave de acceso para entrar a la aplicación pública (diligenciamiento)
APP_CLAVE=cambia-esta-clave

# Credenciales para el Panel de Administrador (acceso en /admin)
ADMIN_USUARIO=admin
ADMIN_CLAVE=admin123

