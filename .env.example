# Cadena de conexión de Neon (Vercel Marketplace > Neon crea esta variable sola)
DATABASE_URL=postgres://usuario:clave@host/db?sslmode=require

# Clave de acceso para entrar a la aplicación pública (diligenciamiento)
APP_CLAVE=cambia-esta-clave

# Credenciales para el Panel de Administrador (acceso en /admin)
ADMIN_USUARIO=admin
ADMIN_CLAVE=admin123
